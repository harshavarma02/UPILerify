# ==========================================
# UPIlerify Developer Configuration Template
# ==========================================
# Copy this file to .env.local:
#   cp .env.example .env.local

# 1. Your Merchant UPI Details (Settlement Destination)
# Standard UPI ID where customer payments will directly settle (0% fees)
DEFAULT_UPI_ID=merchant@upi
DEFAULT_UPI_NAME="Demo Merchant"

# 2. Live Bank IMAP Verification (Gmail)
# Required for sub-2.8s automated mailbox verification.
# Create a 16-character App Password:
# https://myaccount.google.com/apppasswords (Requires Google 2-Step Verification)
GMAIL_ADDRESS=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 3. Webhook Dispatch Configuration (Optional)
# Target endpoint on your backend that will receive signed payment.verified events
WEBHOOK_URL=https://webhook.site/your-unique-url

# 4. SECURITY (REQUIRED — the server will REFUSE TO START without these)
# ⚠️ NO DEFAULT FALLBACKS. Generate real secrets before running:
#   openssl rand -hex 32
# UPILERIFY_API_KEY — admin API key for protected endpoints:
#   POST /api/orders/create, GET /api/orders, GET /api/events (SSE),
#   POST /api/imap/*, POST /api/webhooks/test, POST /api/verify-utr
UPILERIFY_API_KEY=
# WEBHOOK_SECRET — HMAC-SHA256 signing secret for payment.verified webhooks
WEBHOOK_SECRET=

# 4b. STORAGE (Phase 5 — persistent state; SQLite is the default, zero-config)
# Orders, UTR deduplication index and activity logs survive restarts.
DATABASE_PATH=./data/upilerify.db

# 5. App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
